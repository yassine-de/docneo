TOKEN_ENCRYPTION_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 6 — OpenAI (server-only; not used yet)
OPENAI_API_KEY=

# Phase 11 — Stripe (must remain unset until explicitly approved)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
